# Copy this file to .env and fill in your real key locally.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here

# Main text / tool-calling model (unchanged from the working agent)
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Vision-capable model, used only for the image analysis feature
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional tuning
MAX_AGENT_STEPS=8
DEFAULT_CALORIE_BUDGET=2000
MAX_IMAGE_BYTES=6291456
CORS_ALLOW_ORIGINS=*
